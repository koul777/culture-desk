# 1. KOPIS OPEN API
# https://kopis.or.kr/por/cs/openapi/openApiInfo.do?menuId=MNU_00074
KOPIS_API_KEY=

# 2. 한국문화정보원_한눈에보는문화정보조회서비스
# https://www.data.go.kr/data/15138937/openapi.do
# 일반 인증키(Decoding)를 입력하세요.
CULTURE_API_KEY=

PORT=4317
DATABASE_PATH=./data/culture.db
SYNC_INTERVAL_HOURS=24
REQUEST_INTERVAL_MS=350

# Vercel 웹 배포 전용 (로컬 실행에는 불필요)
# Neon integration이 DATABASE_URL을 자동 등록합니다.
DATABASE_URL=
CRON_SECRET=
