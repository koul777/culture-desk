{
  "name": "culture-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "cesium": "^1.146.0",
    "dotenv": "18.0.8",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "leaflet": "^1.9.4",
    "lucide-react": "1.57.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
