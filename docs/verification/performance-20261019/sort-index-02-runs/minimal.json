          "sql": "SELECT p.source,count(*) AS n,\n        SUM(CASE WHEN p.detail_state!='complete' THEN 1 ELSE 0 END) AS pending FROM performances p  WHERE p.classification='performance' AND p.end_date>=? AND p.start_date<=? GROUP BY p.source",
